{
  "displayName": "Model risk: AI accounts must not allow public network access",
  "description": "Foundry and Azure OpenAI accounts that serve tier 1 and tier 2 models must disable public network access and be reached through private endpoints.",
  "mode": "Indexed",
  "metadata": { "category": "AI model governance" },
  "parameters": {
    "effect": {
      "type": "String",
      "allowedValues": ["Audit", "Deny", "Disabled"],
      "defaultValue": "Deny"
    }
  },
  "policyRule": {
    "if": {
      "allOf": [
        { "field": "type", "equals": "Microsoft.CognitiveServices/accounts" },
        { "field": "tags['risk-tier']", "in": ["1", "2"] },
        { "field": "Microsoft.CognitiveServices/accounts/publicNetworkAccess", "notEquals": "Disabled" }
      ]
    },
    "then": { "effect": "[parameters('effect')]" }
  }
}
